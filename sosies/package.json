{
  "name": "sosies",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "npm run build && node tools/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:test-room": "node tools/build-test-room.mjs",
    "optimize": "node tools/optimize-gltf.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lil-gui": "^0.21.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "stats-gl": "^4.2.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
