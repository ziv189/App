      "order": 15,
      "speaker": "WARD",
      "qualifier": null,
      "context": null,
      "script_text": "Just her. By the door. Watching me, like she was waiting for me to do something.",
      "text": "Just her. By the door. Watching me, like she was waiting for me to do something.",
      "directions": [],
      "subtitle_speaker": "WARD",
