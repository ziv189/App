      "order": 10,
      "speaker": "VOICE",
      "qualifier": "INTERCOM",
      "context": null,
      "script_text": "And that night you slept in your bed.",
      "text": "And that night you slept in your bed.",
      "directions": [],
      "subtitle_speaker": "VOICE",
      "variants": [],
      "voice_file": "res://audio/dialogue/scene_34/scene_34-voice-6a84d5.ogg",
