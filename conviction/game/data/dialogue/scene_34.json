      "order": 4,
      "speaker": "WARD",
      "qualifier": null,
      "context": null,
      "script_text": "Then you know I couldn't have—",
      "text": "Then you know I couldn't have—",
      "directions": [],
      "subtitle_speaker": "WARD",
      "variants": [],
      "voice_file": "res://audio/dialogue/scene_34/scene_34-ward-5c9f88.ogg",
