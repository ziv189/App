    {
      "id": "scene_34-ward-d83e85",
      "order": 11,
      "speaker": "WARD",
      "qualifier": null,
      "context": null,
      "script_text": "How do you know that?",
      "text": "How do you know that?",
      "directions": [],
      "subtitle_speaker": "WARD",
      "variants": [],
      "voice_file": "res://audio/dialogue/scene_34/scene_34-ward-d83e85.ogg",
