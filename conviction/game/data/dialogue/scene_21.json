      "order": 5,
      "speaker": "WARD",
      "qualifier": null,
      "context": null,
      "script_text": "You wrote her letters.",
      "text": "You wrote her letters.",
      "directions": [],
      "subtitle_speaker": "WARD",
      "variants": [],
      "voice_file": "res://audio/dialogue/scene_21/scene_21-ward-9df366.ogg",
