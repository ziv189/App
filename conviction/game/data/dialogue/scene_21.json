      "order": 4,
      "speaker": "PRYCE",
      "qualifier": null,
      "context": null,
      "script_text": "I haven't seen Nadine in a year. The order said five hundred feet. I stayed five hundred feet.",
      "text": "I haven't seen Nadine in a year. The order said five hundred feet. I stayed five hundred feet.",
      "directions": [],
      "subtitle_speaker": "PRYCE",
      "variants": [],
